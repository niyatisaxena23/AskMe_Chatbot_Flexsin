"""Persistent chunk store with hybrid (vector + PostgreSQL FTS) retrieval.

Dense vector search is performed by PostgreSQL with pgvector.
Keyword search is performed by PostgreSQL full-text search.
Ranking is fused with Reciprocal Rank Fusion in Python.
"""

import json
import logging
import threading
import time
import uuid
from pathlib import Path

import numpy as np
import psycopg

import embeddings

log = logging.getLogger("askme.store")

STORE_DIR = Path(__file__).parent / "data" / "store"
CHUNKS_PATH = STORE_DIR / "chunks.json"
VECTORS_PATH = STORE_DIR / "vectors.npy"

DB_NAME = "askme_db"
DB_USER = "askme_app"
DB_HOST = "localhost"
DB_PORT = 5432

RRF_K = 60


class VectorStore:
    def __init__(self, chunks=None, vectors=None):
        self.chunks = chunks or []
        self.vectors = (
            vectors
            if vectors is not None
            else np.zeros((0, embeddings.DIM), dtype=np.float32)
        )
        self.embeddings_ok = True
        self._lock = threading.RLock()

    @property
    def sources(self):
        """Ingested documents, newest first, with their chunk counts."""
        grouped = {}

        for chunk in self.chunks:
            sid = chunk["source_id"]

            entry = grouped.setdefault(
                sid,
                {
                    "source_id": sid,
                    "title": chunk.get("source_title", "Untitled"),
                    "type": chunk.get("source_type", "document"),
                    "origin": chunk.get("origin", "paste"),
                    "added_at": chunk.get("added_at", 0),
                    "chunks": 0,
                    "chars": 0,
                },
            )

            entry["chunks"] += 1
            entry["chars"] += len(chunk["text"])

        return sorted(
            grouped.values(),
            key=lambda e: e["added_at"],
            reverse=True,
        )

    def add(
        self,
        texts,
        source_title,
        source_type="document",
        origin="paste",
        tags=(),
    ):
        """Embed and store chunks under a new source id. Returns that id."""
        texts = [t for t in texts if t and t.strip()]

        if not texts:
            raise ValueError("nothing to add")

        source_id = uuid.uuid4().hex[:12]
        now = time.time()

        vectors = embeddings.embed_documents(texts)

        with self._lock:
            for index, text in enumerate(texts):
                self.chunks.append(
                    {
                        "chunk_id": "{}-{:03d}".format(source_id, index),
                        "source_id": source_id,
                        "source_title": source_title,
                        "source_type": source_type,
                        "origin": origin,
                        "tags": list(tags),
                        "text": text,
                        "added_at": now,
                    }
                )

            self.vectors = (
                np.vstack([self.vectors, vectors])
                if len(self.vectors)
                else vectors
            )

            self.save()

        return source_id

    def delete_source(self, source_id):
        with self._lock:
            keep = [
                i
                for i, c in enumerate(self.chunks)
                if c["source_id"] != source_id
            ]

            removed = len(self.chunks) - len(keep)

            if not removed:
                return 0

            self.chunks = [self.chunks[i] for i in keep]

            self.vectors = (
                self.vectors[keep]
                if keep
                else np.zeros(
                    (0, embeddings.DIM),
                    dtype=np.float32,
                )
            )

            self.save()

        return removed

    def _db_connection(self):
        return psycopg.connect(
            f"host={DB_HOST} "
            f"port={DB_PORT} "
            f"dbname={DB_NAME} "
            f"user={DB_USER}"
        )

    def _dense(self, query, top_k):
        """Dense vector search using PostgreSQL + pgvector.

        Keeps the original interface:
            [(chunk_index, cosine_similarity), ...]

        PostgreSQL returns cosine distance.
        Since the embeddings are unit-normalized:

            cosine similarity = 1 - cosine distance
        """
        if not self.embeddings_ok or not len(self.chunks):
            return []

        try:
            q = embeddings.embed_query(query)
        except Exception as exc:  # noqa: BLE001
            log.warning(
                "dense search unavailable (%s); keyword only",
                exc,
            )
            self.embeddings_ok = False
            return []

        if len(q) != embeddings.DIM:
            log.warning(
                "dense search unavailable: expected query dimension %d, got %d",
                embeddings.DIM,
                len(q),
            )
            self.embeddings_ok = False
            return []

        vector_literal = (
            "[" + ",".join(map(str, q.astype(np.float32))) + "]"
        )

        chunk_index = {}

        for index, chunk in enumerate(self.chunks):
            key = (
                chunk.get("source_title", "Untitled"),
                chunk.get("source_type", "document"),
                chunk.get("origin", "paste"),
                index,
            )
            chunk_index[key] = index

        try:
            with self._db_connection() as conn:
                with conn.cursor() as cur:
                    cur.execute(
                        """
                        SELECT
                            s.title,
                            s.type,
                            s.origin,
                            c.ordinal,
                            c.embedding <=> %s::vector AS distance
                        FROM chunks AS c
                        JOIN sources AS s
                          ON s.id = c.source_id
                        ORDER BY c.embedding <=> %s::vector
                        LIMIT %s
                        """,
                        (
                            vector_literal,
                            vector_literal,
                            top_k,
                        ),
                    )

                    rows = cur.fetchall()

        except Exception as exc:  # noqa: BLE001
            log.warning(
                "PostgreSQL dense search unavailable (%s); keyword only",
                exc,
            )
            self.embeddings_ok = False
            return []

        results = []

        for title, source_type, origin, ordinal, distance in rows:
            key = (
                title,
                source_type,
                origin,
                ordinal,
            )

            if key not in chunk_index:
                continue

            index = chunk_index[key]
            similarity = 1.0 - float(distance)

            results.append((index, similarity))

        return results

    def _keyword(self, query, top_k):
        """Keyword search using PostgreSQL full-text search."""
        if not self.chunks or not query.strip():
            return []

        try:
            with self._db_connection() as conn:
                with conn.cursor() as cur:
                    cur.execute(
                        """
                        SELECT
                            c.chunk_id,
                            ts_rank_cd(
                                c.search_vector,
                                websearch_to_tsquery('simple', %s)
                            ) AS rank
                        FROM chunks AS c
                        WHERE c.search_vector @@
                              websearch_to_tsquery('simple', %s)
                        ORDER BY rank DESC, c.id
                        LIMIT %s
                        """,
                        (
                            query,
                            query,
                            top_k,
                        ),
                    )

                    rows = cur.fetchall()

        except Exception as exc:  # noqa: BLE001
            log.warning(
                "PostgreSQL keyword search unavailable: %s",
                exc,
            )
            return []

        index_of = {
            chunk["chunk_id"]: index
            for index, chunk in enumerate(self.chunks)
        }

        results = []

        for chunk_id, score in rows:
            if chunk_id not in index_of:
                continue

            results.append(
                (
                    index_of[chunk_id],
                    float(score),
                )
            )

        return results

    def search(
        self,
        query,
        top_k=5,
        candidates=20,
        min_similarity=0.62,
    ):
        """Hybrid search.

        Returns:
            [
                {
                    "chunk": chunk,
                    "score": fused_rrf_score,
                    "similarity": dense_similarity,
                    "rank_dense": dense_rank,
                    "rank_keyword": keyword_rank,
                }
            ]
        """
        if not self.chunks or not query.strip():
            return []

        dense = self._dense(query, candidates)
        keyword = self._keyword(query, candidates)

        fused = {}

        for rank, (idx, sim) in enumerate(dense):
            entry = fused.setdefault(
                idx,
                {
                    "score": 0.0,
                    "similarity": sim,
                },
            )

            entry["score"] += 1.0 / (
                RRF_K + rank + 1
            )
            entry["rank_dense"] = rank + 1

        for rank, (_idx, _score) in enumerate(keyword):
            idx = _idx

            entry = fused.setdefault(
                idx,
                {
                    "score": 0.0,
                    "similarity": 0.0,
                },
            )

            entry["score"] += 1.0 / (
                RRF_K + rank + 1
            )
            entry["rank_keyword"] = rank + 1

        results = []

        for idx, entry in fused.items():
            if (
                entry["similarity"] >= min_similarity
                or "rank_keyword" in entry
            ):
                results.append(
                    {
                        "chunk": self.chunks[idx],
                        "score": entry["score"],
                        "similarity": round(
                            entry["similarity"],
                            4,
                        ),
                        "rank_dense": entry.get(
                            "rank_dense"
                        ),
                        "rank_keyword": entry.get(
                            "rank_keyword"
                        ),
                    }
                )

        results.sort(
            key=lambda r: r["score"],
            reverse=True,
        )

        return results[:top_k]

    def save(self):
        STORE_DIR.mkdir(
            parents=True,
            exist_ok=True,
        )

        tmp_chunks = CHUNKS_PATH.with_suffix(
            ".json.tmp"
        )
        tmp_vectors = STORE_DIR / "vectors.tmp.npy"

        tmp_chunks.write_text(
            json.dumps(
                {"chunks": self.chunks},
                ensure_ascii=False,
            ),
            encoding="utf-8",
        )

        np.save(
            tmp_vectors,
            self.vectors,
        )

        tmp_chunks.replace(CHUNKS_PATH)
        tmp_vectors.replace(VECTORS_PATH)

    @classmethod
    def load(cls):
        if (
            not CHUNKS_PATH.exists()
            or not VECTORS_PATH.exists()
        ):
            return cls()

        chunks = json.loads(
            CHUNKS_PATH.read_text(
                encoding="utf-8"
            )
        )["chunks"]

        vectors = np.load(VECTORS_PATH)

        if len(chunks) != len(vectors):
            log.error(
                "store is inconsistent (%d chunks, %d vectors) "
                "— starting empty",
                len(chunks),
                len(vectors),
            )
            return cls()

        return cls(
            chunks=chunks,
            vectors=vectors,
        )

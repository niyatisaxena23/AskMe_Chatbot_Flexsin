"""Ask Me -- Flexsin's site assistant. Flask + Groq-hosted Qwen3 + hybrid RAG."""

import json
import logging
import os
import secrets
import time
import uuid
from collections import defaultdict, deque

from dotenv import load_dotenv
from flask import Flask, jsonify, render_template, request

import admin
import embeddings
from guardrails import Anonymizer, strip_reasoning
from llm import GroqClient, LLMError
from prompts import build_messages
from seed import seed
from vectorstore import VectorStore

load_dotenv()

CONTACT_URL = os.getenv("CONTACT_URL", "https://www.flexsin.com/contact-us/")
MAX_QUESTION_CHARS = 1000
RATE_LIMIT_PER_MIN = int(os.getenv("RATE_LIMIT_PER_MIN", "20"))
TOP_K = int(os.getenv("RETRIEVAL_TOP_K", "5"))

# ---------------------------------------------------------------------------
# Public API configuration
# ---------------------------------------------------------------------------

# New format:
#
# ASKME_API_KEYS={
#   "key-for-site-1": {
#       "tenant": "flexsin-widget",
#       "active": true
#   },
#   "key-for-site-2": {
#       "tenant": "another-site",
#       "active": true
#   }
# }
#
# The JSON is stored in .env. Raw keys are never returned or logged.
ASKME_API_KEYS_RAW = os.getenv("ASKME_API_KEYS", "").strip()

# Backward-compatible single-key configuration.
ASKME_API_KEY = os.getenv("ASKME_API_KEY", "").strip()
ASKME_TENANT = os.getenv("ASKME_TENANT", "default").strip() or "default"


def load_api_keys():
    """Load public API keys from the multi-tenant configuration.

    Returns:
        A dictionary mapping API keys to:
            {
                "tenant": str,
                "active": bool,
            }

    The legacy ASKME_API_KEY configuration is supported when
    ASKME_API_KEYS is not configured.
    """
    if ASKME_API_KEYS_RAW:
        try:
            parsed = json.loads(ASKME_API_KEYS_RAW)
        except json.JSONDecodeError:
            log.error("ASKME_API_KEYS contains invalid JSON")
            return {}

        if not isinstance(parsed, dict):
            log.error("ASKME_API_KEYS must be a JSON object")
            return {}

        result = {}

        for api_key, config in parsed.items():
            if not isinstance(api_key, str) or not api_key:
                continue

            if not isinstance(config, dict):
                continue

            tenant = str(config.get("tenant", "")).strip()
            active = config.get("active", True)

            if not tenant:
                log.warning("ignoring public API key with no tenant")
                continue

            result[api_key] = {
                "tenant": tenant,
                "active": bool(active),
            }

        return result

    # Backward compatibility with the original B1 implementation.
    if ASKME_API_KEY:
        return {
            ASKME_API_KEY: {
                "tenant": ASKME_TENANT,
                "active": True,
            }
        }

    return {}


# Set ADMIN_ENABLED=0 on any process that is reachable from the internet
# without a proxy in front of it. The routes are then never registered, so
# there is nothing to guess a token against.
ADMIN_ENABLED = os.getenv("ADMIN_ENABLED", "1") != "0"

NO_CONTEXT_REPLY = (
    "I don't have specific information on that — I'd recommend reaching out to "
    "the team directly at {}.".format(CONTACT_URL)
)

logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s %(levelname)s %(message)s",
)
log = logging.getLogger("askme")

app = Flask(__name__)
app.config["ADMIN_ENABLED"] = ADMIN_ENABLED

if ADMIN_ENABLED:
    app.register_blueprint(admin.bp)

store = VectorStore.load()
app.extensions["askme_store"] = store

anonymizer = Anonymizer(allowed_urls=(CONTACT_URL,))
llm = GroqClient()

SESSIONS = defaultdict(lambda: deque(maxlen=8))
_hits = defaultdict(deque)


def format_context(hits):
    """Render retrieved chunks into the CONTEXT block the system prompt expects."""
    if not hits:
        return "(no relevant context found)"

    blocks = []

    for hit in hits:
        chunk = hit["chunk"]
        blocks.append(
            "[{id} | {type}] {title}\n{text}".format(
                id=chunk["chunk_id"],
                type=chunk.get("source_type", "document"),
                title=chunk.get("source_title", ""),
                text=chunk["text"],
            )
        )

    return "\n\n---\n\n".join(blocks)


def rate_limited(key):
    now = time.time()
    bucket = _hits[key]

    while bucket and now - bucket[0] > 60:
        bucket.popleft()

    if len(bucket) >= RATE_LIMIT_PER_MIN:
        return True

    bucket.append(now)
    return False


def authenticate_api_key():
    """Authenticate a public API request.

    Returns:
        (tenant, None) when authentication succeeds.
        (None, Flask response) when authentication fails.

    Authentication happens before request validation, rate limiting,
    retrieval, or LLM work.

    The raw API key is never logged or returned.
    """
    supplied = request.headers.get("X-API-Key", "").strip()

    api_keys = load_api_keys()

    if not api_keys:
        log.error("public API keys are not configured")
        return (
            None,
            (
                jsonify(error="Public API is not configured."),
                503,
            ),
        )

    if not supplied:
        return (
            None,
            (
                jsonify(error="Invalid or missing API key."),
                401,
            ),
        )

    config = api_keys.get(supplied)

    if config is None:
        return (
            None,
            (
                jsonify(error="Invalid or missing API key."),
                401,
            ),
        )

    if not config["active"]:
        return (
            None,
            (
                jsonify(error="Invalid or missing API key."),
                401,
            ),
        )

    # Constant-time comparison against the configured key.
    # The dictionary lookup above identifies the configuration; this
    # comparison ensures the actual secret comparison is not a simple
    # early-exit string comparison.
    matched_key = None

    for configured_key in api_keys:
        if secrets.compare_digest(supplied, configured_key):
            matched_key = configured_key
            break

    if matched_key is None:
        return (
            None,
            (
                jsonify(error="Invalid or missing API key."),
                401,
            ),
        )

    return config["tenant"], None


def public_rate_limit_key(tenant):
    """Return a stable rate-limit identity without exposing the API key."""
    client_ip = request.headers.get(
        "X-Forwarded-For",
        request.remote_addr or "-",
    )
    client_ip = client_ip.split(",")[0].strip()

    return "{}:{}".format(tenant, client_ip)


@app.get("/")
def index():
    return render_template("index.html", contact_url=CONTACT_URL)


@app.get("/healthz")
def healthz():
    return jsonify(
        status="ok",
        chunks=len(store.chunks),
        sources=len(store.sources),
        model=llm.model,
        embed_model=embeddings.MODEL_NAME,
        llm_configured=llm.configured,
        embeddings_ok=store.embeddings_ok,
        admin_enabled=ADMIN_ENABLED,
    )


@app.post("/api/chat")
def chat():
    body = request.get_json(silent=True) or {}
    question = (body.get("message") or "").strip()
    session_id = (body.get("session_id") or "").strip() or uuid.uuid4().hex

    if not question:
        return jsonify(error="Please enter a question."), 400

    if len(question) > MAX_QUESTION_CHARS:
        return jsonify(
            error="That message is too long — try trimming it down."
        ), 400

    client_ip = request.headers.get(
        "X-Forwarded-For",
        request.remote_addr or "-",
    )
    client_ip = client_ip.split(",")[0].strip()

    if rate_limited(client_ip):
        return jsonify(error="Too many messages — give it a minute."), 429

    hits = store.search(question, top_k=TOP_K)
    history = SESSIONS[session_id]

    # Nothing retrieved: the grounding rule already dictates the answer,
    # so skip the model call entirely.
    if not hits:
        log.info("no context for: %s", question[:120])

        history.append(("user", question))
        history.append(("assistant", NO_CONTEXT_REPLY))

        return jsonify(
            reply=NO_CONTEXT_REPLY,
            session_id=session_id,
            sources=[],
            grounded=False,
        )

    context = anonymizer.scrub(format_context(hits))

    messages = build_messages(
        question,
        context,
        history=list(history),
        contact_url=CONTACT_URL,
    )

    try:
        raw = llm.complete(messages)
    except LLMError as exc:
        log.error("llm failure: %s", exc)

        return (
            jsonify(
                error="I'm having trouble responding right now. Please try again, or "
                "reach the team at {}.".format(CONTACT_URL)
            ),
            502,
        )

    reply = anonymizer.scrub_answer(strip_reasoning(raw))

    if not reply:
        reply = NO_CONTEXT_REPLY

    history.append(("user", question))
    history.append(("assistant", reply))

    # Deduplicate sources: several chunks often come from one document.
    seen = []

    for hit in hits:
        entry = {
            "id": hit["chunk"]["source_id"],
            "title": hit["chunk"].get("source_title", ""),
        }

        if entry not in seen:
            seen.append(entry)

    return jsonify(
        reply=reply,
        session_id=session_id,
        sources=seen,
        grounded=True,
    )


@app.post("/api/public/chat")
def public_chat():
    """Public API endpoint requiring a valid tenant API key."""

    # IMPORTANT:
    # This must happen before retrieval.
    tenant, auth_error = authenticate_api_key()

    if auth_error is not None:
        return auth_error

    body = request.get_json(silent=True) or {}
    question = (body.get("message") or "").strip()
    session_id = (body.get("session_id") or "").strip() or uuid.uuid4().hex

    if not question:
        return jsonify(error="Please enter a question."), 400

    if len(question) > MAX_QUESTION_CHARS:
        return jsonify(
            error="That message is too long — try trimming it down."
        ), 400

    rate_key = public_rate_limit_key(tenant)

    if rate_limited(rate_key):
        return jsonify(error="Too many messages — give it a minute."), 429

    # Authentication and validation have completed before retrieval begins.
    hits = store.search(question, top_k=TOP_K)
    history = SESSIONS[session_id]

    if not hits:
        log.info(
            "public API no context tenant=%s question=%s",
            tenant,
            question[:120],
        )

        history.append(("user", question))
        history.append(("assistant", NO_CONTEXT_REPLY))

        return jsonify(
            reply=NO_CONTEXT_REPLY,
            session_id=session_id,
            sources=[],
            grounded=False,
            tenant=tenant,
        )

    context = anonymizer.scrub(format_context(hits))

    messages = build_messages(
        question,
        context,
        history=list(history),
        contact_url=CONTACT_URL,
    )

    try:
        raw = llm.complete(messages)
    except LLMError as exc:
        log.error(
            "public API llm failure tenant=%s: %s",
            tenant,
            exc,
        )

        return (
            jsonify(
                error="I'm having trouble responding right now. Please try again, or "
                "reach the team at {}.".format(CONTACT_URL)
            ),
            502,
        )

    reply = anonymizer.scrub_answer(strip_reasoning(raw))

    if not reply:
        reply = NO_CONTEXT_REPLY

    history.append(("user", question))
    history.append(("assistant", reply))

    seen = []

    for hit in hits:
        entry = {
            "id": hit["chunk"]["source_id"],
            "title": hit["chunk"].get("source_title", ""),
        }

        if entry not in seen:
            seen.append(entry)

    return jsonify(
        reply=reply,
        session_id=session_id,
        sources=seen,
        grounded=True,
        tenant=tenant,
    )


@app.post("/api/reset")
def reset():
    session_id = (
        (request.get_json(silent=True) or {})
        .get("session_id", "")
        .strip()
    )

    SESSIONS.pop(session_id, None)

    return jsonify(ok=True)


if __name__ == "__main__":
    if not llm.configured:
        log.warning(
            "GROQ_API_KEY is not set — /api/chat will return 502."
        )

    if not load_api_keys():
        log.warning(
            "No public API keys configured — /api/public/chat will return 503."
        )

    store.embeddings_ok = embeddings.warm_up()

    if not store.chunks:
        log.info(
            "store is empty — seeding from data/knowledge.json"
        )
        seed(store)

    log.info(
        "%d chunks across %d sources",
        len(store.chunks),
        len(store.sources),
    )

    if ADMIN_ENABLED and admin.TOKEN_IS_GENERATED:
        log.warning(
            "ADMIN_TOKEN not set — this run's token is: %s  (panel at /admin)",
            admin.ADMIN_TOKEN,
        )

    app.run(
        host="0.0.0.0",
        port=int(os.getenv("PORT", "5000")),
        debug=os.getenv("FLASK_DEBUG") == "1",
    )